      677 +/* Split a term on top-level ':' only, so that a ':' inside I(
          +...) is left                                                  
      678 + * alone. Returns the component count and fills starts[]/lens[
          +]. */                                                         
      679 +static unsigned int lm_split_term(const char *restrict term,  
      680 +                                  const char **restrict starts
          +,                                                             
      681 +                                  size_t *restrict lens,      
      682 +                                  unsigned int cap) {         
      683 +  unsigned int n = 0;                                         
      684 +  int depth = 0;                                              
      685 +  const char *restrict p = term, *restrict start = term;      
      686 +  for (;; p++) {                                              
      687 +    if (*p == '(') depth++;                                   
      688 +    else if (*p == ')') { if (depth > 0) depth--; }           
      689 +    if ((*p == ':' && depth == 0) || *p == '\0') {            
      690 +      if (n < cap) { starts[n] = start; lens[n] = (size_t)(p -
          + start); }                                                    
      691 +      n++;                                                    
      692 +      if (*p == '\0') break;                                  
      693 +      start = p + 1;                                          
      694 +    }                                                         
      695 +  }                                                           
      696 +  return n;                                                   
      697 +}                                                             
