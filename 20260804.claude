       964 +/* Expand one `*`-crossed chunk of a formula into model terms
           +.                                                            
       965 + *                                                           
       966 + * `a*b` is a + b + a:b, and crossing is associative, so `a*b
           +*c` is every                                                 
       967 + * non-empty subset: a, b, c, a:b, a:c, b:c, a:b:c. Subsets a
           +re emitted by                                                
       968 + * increasing degree and, within a degree, in the left-to-rig
           +ht order of the                                              
       969 + * formula, which is the order R's terms() produces. A chunk 
           +with no `*` is one                                           
       970 + * term and is appended unchanged.                           
       971 + *                                                           
       972 + * `^` is crossing rather than exponentiation in a formula, s
           +o a trailing `^n` on                                         
       973 + * a component is dropped -- `hp^2` is just hp -- unless the 
           +component is an                                              
       974 + * I(...) escape, where the caret is arithmetic and belongs t
           +o evaluate_term.                                             
       975 + *                                                           
       976 + * chunk is written through: the separators become NULs.     
       977 + */                                                          
       978 +static void lm_expand_cross(pTHX_ char *restrict chunk,      
       979 +                            char ***restrict terms,          
       980 +                            unsigned int *restrict num_terms,
       981 +                            unsigned int *restrict term_cap) 
           +{                                                            
       982 +  char *restrict part[16];                                   
       983 +  unsigned int k = 0, i;                                     
       984 +  UV mask, limit;                                            
       985 +  char *restrict s = chunk;                                  
       986 +                                                             
       987 +  for (;;) {                                                 
       988 +    char *restrict star = strchr(s, '*');                    
       989 +    if (k >= (unsigned int)(sizeof(part) / sizeof(part[0]))) 
       990 +      croak("lm: formula crosses more than %u terms with '*'"
           +,                                                            
       991 +            (unsigned int)(sizeof(part) / sizeof(part[0]))); 
       992 +    if (star) *star = '\0';                                  
       993 +    {                                                        
       994 +      char *restrict caret = strchr(s, '^');                 
       995 +      if (caret && strncmp(s, "I(", 2) != 0) *caret = '\0';  
       996 +    }                                                        
       997 +    part[k++] = s;                                           
       998 +    if (!star) break;                                        
       999 +    s = star + 1;                                            
      1000 +  }                                                          
      1001 +                                                             
      1002 +  limit = (UV)1 << k;                                        
      1003 +  /* Grow once for the worst case rather than testing inside 
           +the loop. */                                                 
      1004 +  if (*num_terms + (limit - 1) + 1 >= (UV)*term_cap) {       
      1005 +    while ((UV)*term_cap <= *num_terms + limit) *term_cap *= 
           +2;                                                           
      1006 +    Renew(*terms, *term_cap, char*);                         
      1007 +  }                                                          
      1008 +  for (i = 1; i <= k; i++) {                    /* degree */ 
      1009 +    for (mask = 1; mask < limit; mask++) {                   
      1010 +      unsigned int bits = 0, b;                              
      1011 +      size_t len = 0;                                        
      1012 +      char *restrict nm;                                     
      1013 +      for (b = 0; b < k; b++) if (mask & ((UV)1 << b)) bits++
           +;                                                            
      1014 +      if (bits != i) continue;                               
      1015 +      for (b = 0; b < k; b++)                                
      1016 +        if (mask & ((UV)1 << b)) len += strlen(part[b]) + 1; 
      1017 +      Newxz(nm, len + 1, char);                              
      1018 +      for (b = 0; b < k; b++) {                              
      1019 +        if (!(mask & ((UV)1 << b))) continue;                
      1020 +        if (*nm) strcat(nm, ":");                            
      1021 +        strcat(nm, part[b]);                                 
      1022 +      }                                                      
      1023 +      (*terms)[(*num_terms)++] = nm;                         
      1024 +    }                                                        
      1025 +  }                                                          
      1026 +}                                                            
      1027 +                                                             
      1028  /* Fill one row of the design matrix. Returns FALSE when the 
            row is incomplete,
      1029   * i.e. when any factor it needs has no readable value or any
             continuous term
      1030   * evaluates to NaN; the caller drops such rows, as R's na.om
            it does. */

