        -: 1891:/*Design-matrix construction, shared by lm() and glm().
        -: 1892:
        -: 1893: A model term is a set of variables: "wt" is one, "wt:hp" is two, and a
        -: 1894: variable holding strings is a factor that expands to indicator columns. The
        -: 1895: question each factor raises is whether to emit a column for every level or to
        -: 1896: drop the first as a reference, and R answers it with the margin rule:
        -: 1897:
        -: 1898:   The factor f inside term T is coded by contrasts -- reference level dropped
        -: 1899:   -- when T with f removed is itself a term of the model, and by full
        -: 1900:   indicators when it is not. The empty margin, which is what a main effect
        -: 1901:   reduces to once its own variable is removed, counts as present whenever the
        -: 1902:   model has an intercept. Without an intercept it counts as present only
        -: 1903:   after the first factor main effect has consumed it.
        -: 1904:
        -: 1905: That one rule reproduces R everywhere:
        -: 1906:
        -: 1907:   y ~ g          g's margin is empty and the intercept supplies it, so g is
        -: 1908:                  coded by contrasts: gb, gc.
        -: 1909:   y ~ g - 1      nothing supplies the empty margin, so g is coded in full:
        -: 1910:                  ga, gb, gc. This is the case that used to lose a level and
        -: 1911:                  fit a model forcing the reference group's fitted values to 0.
        -: 1912:   y ~ a + b - 1  a consumes the empty margin and is coded in full; b then
        -: 1913:                  finds it present and is coded by contrasts. Coding both in
        -: 1914:                  full would be rank deficient.
        -: 1915:   y ~ a * b      both main effects are present, so both components of a:b are
        -: 1916:                  coded by contrasts: aB:bY.
        -: 1917:   y ~ a:b        neither main effect is present, so both components are coded
        -: 1918:                  in full and the term spans the whole cross-classification.
        -: 1919:
        -: 1920:Terms are ordered by degree first, as R's terms() does, so that a margin is
        -: 1921:always decided against terms that precede it.*/
        -: 1922:
        -: 1923:// Defined further down, next to the other qsort comparators
        -: 1924:static int cmp_string_wt(const void *a, const void *b);
        -: 1925:
        -: 1926://One component of one design column.
        -: 1927:typedef struct {
        -: 1928:	int         fbase; //index into LmDesign.factor, or -1 when continuous
        -: 1929:	const char *level; //borrowed from LmFactor.level, when fbase >= 0
        -: 1930:	const char *expr;  //borrowed from LmDesign.var,   when fbase <  0
        -: 1931:} LmComp;
        -: 1932:
        -: 1933:typedef struct {
        -: 1934:	char        *name;
        -: 1935:	char       **level;
        -: 1936:	unsigned int nlevel;
        -: 1937:} LmFactor;
        -: 1938:
        -: 1939:typedef struct {
        -: 1940:	char        *name; //the coefficient name, e.g. "woolB:tensionM"
        -: 1941:	LmComp      *comp;
        -: 1942:	unsigned int ncomp; //0 marks the intercept column
        -: 1943:} LmCol;
        -: 1944:
        -: 1945:typedef struct {
        -: 1946:	LmFactor    *factor;
        -: 1947:	unsigned int nfactor;
        -: 1948:	LmCol       *col;
        -: 1949:	unsigned int ncol;
        -: 1950:	char       **var;  //every distinct variable named by any term
        -: 1951:	unsigned int nvar;
        -: 1952:	char       **raw;  //scratch: this row's raw level per factor
        -: 1953:} LmDesign;
