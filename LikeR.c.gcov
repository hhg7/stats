        -: 1955:static void lm_design_free(pTHX_ LmDesign *d) {
        -: 1956:	unsigned int i, j;
        -: 1957:	if (!d) return;
        -: 1958:	if (d->factor) {
        -: 1959:		for (i = 0; i < d->nfactor; i++) {
        -: 1960:			if (d->factor[i].level) {
        -: 1961:				for (j = 0; j < d->factor[i].nlevel; j++)
        -: 1962:					Safefree(d->factor[i].level[j]);
        -: 1963:				Safefree(d->factor[i].level);
        -: 1964:			}
        -: 1965:			Safefree(d->factor[i].name);
        -: 1966:		}
        -: 1967:		Safefree(d->factor);
        -: 1968:	}
        -: 1969:	if (d->col) {
        -: 1970:		for (i = 0; i < d->ncol; i++) {
        -: 1971:			Safefree(d->col[i].name);
        -: 1972:			if (d->col[i].comp) Safefree(d->col[i].comp);
        -: 1973:		}
        -: 1974:		Safefree(d->col);
        -: 1975:	}
        -: 1976:	if (d->var) {
        -: 1977:		for (i = 0; i < d->nvar; i++) Safefree(d->var[i]);
        -: 1978:		Safefree(d->var);
        -: 1979:	}
        -: 1980:	if (d->raw) Safefree(d->raw);
        -: 1981:	Safefree(d);
        -: 1982:}
