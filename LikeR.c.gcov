        -: 1984:/*Split a term on top-level ':' only, so that a ':' inside I(...) is left
        -: 1985:alone. Returns the component count and fills starts[]/lens[].*/
        -: 1986:static unsigned int lm_split_term(const char *restrict term,
        -: 1987:                                  const char **restrict starts,
        -: 1988:                                  size_t *restrict lens,
        -: 1989:                                  unsigned int cap) {
        -: 1990:	unsigned int n = 0;
        -: 1991:	int depth = 0;
        -: 1992:	const char *restrict p = term, *start = term;
        -: 1993:	for (;; p++) {
        -: 1994:		if (*p == '(') depth++;
        -: 1995:		else if (*p == ')') { if (depth > 0) depth--; }
        -: 1996:		if ((*p == ':' && depth == 0) || *p == '\0') {
        -: 1997:			if (n < cap) { starts[n] = start; lens[n] = (size_t)(p - start); }
        -: 1998:			n++;
        -: 1999:			if (*p == '\0') break;
        -: 2000:			start = p + 1;
        -: 2001:		}
        -: 2002:	}
        -: 2003:	return n;
        -: 2004:}
