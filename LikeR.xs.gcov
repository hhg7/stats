   153140: 9812:static void moment_push(moment_acc *a, NV x) {
   153140: 9813:	const NV n1 = (NV)a->n; // count before this observation
   153140: 9814:	a->n++;
   153140: 9815:	const NV n     = (NV)a->n;
   153140: 9816:	const NV delta = x - a->mean;
   153140: 9817:	const NV dn    = delta / n;
   153140: 9818:	const NV dn2   = dn * dn;
   153140: 9819:	const NV term  = delta * dn * n1; // == n1/n * delta^2
   153140: 9820:	a->m4   += term * dn2 * (n * n - 3.0 * n + 3.0)
   153140: 9821:	         + 6.0 * dn2 * a->m2 - 4.0 * dn * a->m3;
   153140: 9822:	a->m3   += term * dn * (n - 2.0) - 3.0 * dn * a->m2;
   153140: 9823:	a->m2   += term;
   153140: 9824:	a->mean += dn;
   153140: 9825:}
