require 5.010;
use strict;
use warnings FATAL => 'all';
use Test::More;
use Stats::LikeR 't_test';

# Cross-validation of t_test() against R's stats::t.test() and SciPy's
# scipy.stats.ttest_*, using those projects' own test suites and man-page
# examples rather than cases invented here.  t/t_test.t already covers the call
# shapes, the croak messages and leak checking; this file does not repeat them.
#
# PROVENANCE
# ----------
# The frozen tables live in the DATA section at the end of this file: R's half
# first, then SciPy's after a marker line.  Neither generator is ever run by the
# test, so the distribution installs and tests with no R and no python present.
#
# R 4.6.1 (2026-06-24), regenerated by t/t_test.R.R:
#
#   src/library/stats/man/t.test.Rd
#       t.test(1:10, y = c(7:20))          (the page's own "P = .00001855")
#       t.test(1:10, y = c(7:20, 200))     (the page's own "P = .1245")
#       with(mtcars, t.test(mpg[am == 0], mpg[am == 1]))
#       t.test(sleep$extra), and the paired wide-format sleep test
#   tests/reg-tests-1a.R:4529
#       "t.test with one group of size one", both orientations, var.equal=TRUE
#       -- these failed outright in R 2.4.0, so they are a real regression case
#       and not a synthetic edge
#   tests/reg-tests-2.R:3199
#       print(t.test(1:28), digits = 3)
#   tests/reg-tests-1e.R:1985
#       t.test(<Inf>...), PR#18901 -- these errored in R <= 4.5.1
#
# SciPy 1.18.0, scipy/stats/tests/test_stats.py, reproduced at SciPy's own
# values and tolerances:
#
#   TestTTest_1samp                 X1 = [-1,0,1] at mu 0, 1, 2 and X2 = [0,1,2],
#                                   upstream comment "Recomputed statistics and
#                                   p-values with R t.test"
#   TestTTestIndMore
#     .test_ttest_ind_with_uneq_var  [1,2,3] and [1,2,3,4] against [1.1,2.9,4.2],
#                                    upstream comment "check vs. R `t.test`"
#     .test_ttest_ind_nan_2nd_arg    the NaN-dropped pair, upstream comment
#                                    "this is consistent with R"
#     .test_ttest_uniform_pvalues    t.test(c(2,3,5), c(1.5), var.equal=TRUE) --
#                                    a second group of size ONE
#     .test_ttest_ind_zero_division  zeros vs ones, and a sample against itself
#   TestTTestRel.test_ttest_rel      the linspace pair, paired
#   TestTTestCI                      the 11-vs-13 sample at conf.level 0.9,
#                                    whose reference values SciPy itself
#                                    obtained from R
#
# Every documented case is then crossed over the whole argument space --
# alternative x var_equal x mu x conf.level x paired -- because a reference case
# exercised only at its defaults pins one code path out of dozens.  That is what
# takes two dozen upstream cases to the 273 comparisons in the table.
#
# WHAT WRITING THIS FILE TURNED UP
# --------------------------------
# t_test() accepted only the underscored 'conf_level' and 'var_equal', so the
# 'conf.level' its own documentation lists -- and the 'var.equal' R spells it
# with -- were a croak rather than an argument, even though every sibling in the
# module (var_test, wilcox_test, prop_test, glm, ...) already took both.  Fixed
# in LikeR.xs; the section near the end keeps both spellings tested.
#
# TOLERANCES
# ----------
# $TOL_R applies to everything joined against the R table, whose values carry
# 17 significant digits.  Worst disagreements actually measured over the
# 2400-odd comparisons here, on each NV width in the local matrix:
#
#                    double     long double / __float128
#   statistic        1.83e-15   1.85e-12
#   p.value          6.46e-15   2.06e-12
#   estimate         6.51e-16   2.08e-12
#   conf.int         2.34e-13   1.55e-12
#   df               8.61e-16   5.63e-16
#
# The wider widths are the worse ones here, and that is expected rather than a
# defect: the linspace inputs below are not dyadic, so on a long-double or
# quadmath perl the literals parse to values a relative 1e-17 away from the
# doubles R and numpy saw, and the statistic carries that straight through.  It
# is the input that differs, not the arithmetic -- the same tables on the same
# integer-valued inputs (sleep, mtcars, 1:10) agree to 1 ulp on every width.
#
# The limit is set from the widest width's worst case with two orders of
# headroom, since neither Windows' nor a BSD's long double can be measured
# here.  Do not widen it to make a failure go away.
#
# $TOL_SCIPY is looser only because SciPy's literals are shorter, not because
# anything is less accurate: the TestTTestCI block carries 7 digits and says so
# upstream ("rtol = 1e-7  # only 7 digits in reference").
#
# The linspace inputs are reproduced as start + i*step with the last element
# pinned to the stop, which is what numpy's linspace computes, so the vector
# here really is SciPy's.  Its elements are not dyadic, so on a long-double or
# quadmath perl they parse to values a relative 1e-17 from the doubles R and
# numpy saw.  Both statistics are well conditioned in those inputs -- the two
# samples differ by ~0.01 throughout, not by an ulp, so nothing cancels -- and
# that perturbation stays well inside $TOL_R.  Do not widen these to make a
# failure go away.
my $TOL_R     = 1e-10;
my $TOL_SCIPY = 1e-7;

#
# The input vectors, exactly as the two references have them.
#
my @MTCARS_AM0 = (21.4, 18.7, 18.1, 14.3, 24.4, 22.8, 19.2, 17.8, 16.4, 17.3,
                  15.2, 10.4, 10.4, 14.7, 21.5, 15.5, 15.2, 13.3, 19.2);
my @MTCARS_AM1 = (21, 21, 22.8, 32.4, 30.4, 33.9, 27.3, 26, 30.4, 15.8, 19.7,
                  15, 21.4);
my @SLEEP1 = (0.7, -1.6, -0.2, -1.2, -0.1, 3.4, 3.7, 0.8, 0, 2);
my @SLEEP2 = (1.9, 0.8, 1.1, 0.1, -0.1, 4.4, 5.5, 1.6, 4.6, 3.4);

# numpy.linspace(start, stop, n): start + i*step, with the last element set
# exactly to stop.  Reproduced rather than transcribed so the 100-element
# vectors do not have to be pasted at 17 digits apiece.
sub linspace {
	my ($a, $b, $n) = @_;
	my $step = ($b - $a) / ($n - 1);
	my @v = map { $a + $step * $_ } 0 .. $n - 1;
	$v[$n - 1] = $b;
	return \@v;
}

