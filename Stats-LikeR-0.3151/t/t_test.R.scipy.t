my $INF = 9**9**9;

# Relative compare that also copes with the exact 0, the NA and the +-Inf the
# references report at the boundaries.  Returns (ok, relative error).
sub close_to {
	my ($got, $exp, $name, $tol) = @_;
	if ($exp eq 'NA') {
		return (ok(!defined $got || $got != $got, "$name is NA"), undef);
	}
	if ($exp eq 'Inf' || $exp eq '-Inf') {
		my $want = $exp eq 'Inf' ? $INF : -$INF;
		return (ok(defined $got && $got == $want, "$name is $exp"), undef);
	}
	if (!defined $got) {
		fail("$name: got undef, expected $exp");
		return (0, undef);
	}
	my $err = $exp == 0 ? abs($got) : abs($got - $exp) / abs($exp);
	my $ok = $err <= $tol;
	ok($ok, $name)
		or diag(sprintf 'got %.17g, expected %s, rel err %.4g (tol %.3g)',
			$got, $exp, $err, $tol);
	return ($ok, $err);
}

my %worst;
sub note_worst {
	my ($field, $err) = @_;
	$worst{$field} = $err if defined $err && $err > ($worst{$field} || 0);
}

# A label is  tag|form|alternative|ve=..|mu=..|cl=..|p=..  with the ve and p
# parts absent for the one-sample form, which is spelled 1s.
sub options_from {
	my ($label) = @_;
	my @part = split /\|/, $label;
	my $tag  = shift @part;
	my $form = shift @part;
	my %opt;
	for my $p (@part) {
		if    ($p =~ /\Amu=(\S+)\z/) { $opt{mu}           = $1 + 0 }
		elsif ($p =~ /\Acl=(\S+)\z/) { $opt{'conf.level'} = $1 + 0 }
		elsif ($p =~ /\Ave=(\d)\z/)  { $opt{var_equal}    = $1 + 0 }
		elsif ($p =~ /\Ap=(\d)\z/)   { $opt{paired}       = $1 + 0 }
		else                         { $opt{alternative}  = $p }
	}
	return ($tag, $form, \%opt);
}

sub run_r_case {
	my ($label, $exp) = @_;
	my ($tag, $form, $opt) = options_from($label);
	my $in = $INPUT{$tag} or do { fail("no input registered for '$tag'"); return };
	my @args = $form eq '1s' ? ($in->[0]) : ($in->[0], $in->[1]);
	my $r = eval { t_test(@args, %$opt) };
	if ($@) { fail("R $label: t_test died: $@"); return }

	my ($stat, $param, $pval, $est, $lo, $hi) = @$exp;
	for my $f (['statistic', $stat], ['df', $param], ['p.value', $pval]) {
		my (undef, $e) = close_to($r->{ $f->[0] }, $f->[1], "R $label: $f->[0]", $TOL_R);
		note_worst($f->[0], $e);
	}
	# One-sample and paired tests return a single 'estimate'; the two-sample
	# test returns 'estimate.x' and 'estimate.y', matching R's own
	# names(estimate) for that case ("mean of x", "mean of y").
	my @est_exp = split /,/, $est;
	my @est_got = @est_exp > 1 ? ($r->{'estimate.x'}, $r->{'estimate.y'})
	                           : ($r->{estimate});
	is(scalar(grep { defined } @est_got), scalar @est_exp, "R $label: estimate count");
	for my $i (0 .. $#est_exp) {
		my (undef, $e) = close_to($est_got[$i], $est_exp[$i],
			"R $label: estimate[$i]", $TOL_R);
		note_worst('estimate', $e);
	}
	return if $lo eq '-';
	my $ci = $r->{'conf.int'};
	ok(ref $ci eq 'ARRAY', "R $label: conf.int present") or return;
	for my $i (0, 1) {
		my (undef, $e) = close_to($ci->[$i], ($i ? $hi : $lo),
			"R $label: conf.int[$i]", $TOL_R);
		note_worst('conf.int', $e);
	}
}

# SciPy's cases in SciPy's own terms, so this file fails if either reference is
# contradicted rather than only R.
sub run_scipy_case {
	my ($what, $v) = @_;
	my ($tag, $form, $opt) = options_from($what);
	my $in = $INPUT{$tag} or do { fail("no input registered for '$tag'"); return };
	my @args = $form eq '1s' ? ($in->[0]) : ($in->[0], $in->[1]);
	my $r = eval { t_test(@args, %$opt) };
	if ($@) { fail("scipy $what: t_test died: $@"); return }
	my ($stat, $df, $p, $lo, $hi) = @$v;
	close_to($r->{statistic}, $stat, "scipy $what: statistic", $TOL_SCIPY);
	close_to($r->{df},        $df,   "scipy $what: df",        $TOL_SCIPY)
		unless $df eq '-';
	close_to($r->{'p.value'}, $p,    "scipy $what: p.value",   $TOL_SCIPY);
	return if !defined $lo || $lo eq '-';
	close_to($r->{'conf.int'}[0], $lo, "scipy $what: conf.int lo", $TOL_SCIPY);
	close_to($r->{'conf.int'}[1], $hi, "scipy $what: conf.int hi", $TOL_SCIPY);
}

my ($rows_R, $rows_scipy, $section) = (0, 0, 'R');
while (my $line = <DATA>) {
	next if $line =~ /\A\s*#/ || $line !~ /\S/;
	chomp $line;
	if ($line eq 'SCIPY-SECTION') { $section = 'SCIPY'; next }
	if ($section eq 'R') {
		my ($label, undef, @v) = split /\t/, $line;
		$rows_R++;
		run_r_case($label, \@v);
	}
	else {
		my ($what, @v) = split /\t/, $line;
		$rows_scipy++;
		run_scipy_case($what, \@v);
	}
}

cmp_ok($rows_R,     '>', 250, "R reference cases exercised ($rows_R)");
cmp_ok($rows_scipy, '>',   8, "SciPy reference cases exercised ($rows_scipy)");

#
# Cases no table can hold, because the reference's answer is an error rather
# than a number -- and where R and SciPy differ by design.  Both behaviours are
# recorded so that changing either is deliberate.
#
# scipy.stats.ttest_ind(zeros(3), ones(3)) warns "Precision loss occurred" and
# returns (-inf, 0.0); R's t.test(rep(0,3), rep(1,3)) is a hard error, "data
# are essentially constant".  t_test() follows R, which is what it is modelled
# on.  Likewise a sample against itself, where SciPy returns NaN.
{
	my $r = eval { t_test([0, 0, 0], [1, 1, 1]) };
	ok(!defined $r, 'zero variance in both groups is fatal, as in R');
	like($@, qr/essentially constant/,
		"...with R's own 'data are essentially constant' wording");

	$r = eval { t_test([0, 0, 0], [0, 0, 0]) };
	ok(!defined $r, 'a sample against itself is fatal, as in R');

	$r = eval { t_test([4], mu => 3) };
	ok(!defined $r, 'a one-sample test on n = 1 is fatal, as in R');

	# R needs both groups >= 2 unless var.equal makes n = 1 usable, which is
	# exactly what reg-tests-1a.R:4529 pins.  Welch with n = 1 has no df.
	$r = eval { t_test([2, 3, 5], [1.5]) };
	ok(!defined $r, 'Welch with a single y observation is fatal');
	$r = eval { t_test([2, 3, 5], [1.5], var_equal => 1) };
	ok(ref $r, 'the same call with var_equal => 1 succeeds, as in R');

	# t.test(<Inf>...) -- reg-tests-1e.R:1985, PR#18901.  R returns estimate
	# Inf with an NA p-value and NA conf.int rather than erroring, and these
	# calls errored in R <= 4.5.1.  The two references disagree on the details,
	# so all that is asserted is that a non-finite observation does not take
	# the process down.
	$r = eval { t_test([1 .. 6, $INF]) };
	ok(1, 'a non-finite observation does not crash the process');
}

#
# Both spellings of the two dotted R argument names.  'conf.level' is what this
# function's own documentation lists and was a croak until the fix noted above;
# 'var.equal' is R's spelling, which every sibling already accepted.
#
{
	my $u = t_test([1 .. 10], [7 .. 20], conf_level => 0.99, var_equal => 1);
	my $d = t_test([1 .. 10], [7 .. 20], 'conf.level' => 0.99, 'var.equal' => 1);
	is($d->{'p.value'},     $u->{'p.value'},     "'var.equal' == 'var_equal'");
	is($d->{'conf.int'}[0], $u->{'conf.int'}[0], "'conf.level' == 'conf_level' (lower)");
	is($d->{'conf.int'}[1], $u->{'conf.int'}[1], "'conf.level' == 'conf_level' (upper)");

	# The level must actually be used, so that accepting the argument cannot be
	# mistaken for ignoring it -- which is the other way the croak could have
	# been made to go away.
	my $narrow = t_test([1 .. 10], [7 .. 20], 'conf.level' => 0.90);
	my $wide   = t_test([1 .. 10], [7 .. 20], 'conf.level' => 0.999);
	cmp_ok($wide->{'conf.int'}[0], '<', $narrow->{'conf.int'}[0],
		'a higher conf.level really widens the interval');
	cmp_ok($wide->{'conf.int'}[1], '>', $narrow->{'conf.int'}[1],
		'...on both sides');
}

# An unrecognised alternative must be fatal rather than silently two-sided;
# SciPy raises ValueError and R errors on the partial match.
{
	my $r = eval { t_test([1, 2, 3], mu => 0, alternative => 'error') };
	ok(!defined $r, 'an unknown alternative is fatal');
	# SciPy spells the two-sided alternative with a hyphen; both must work.
	my $a = t_test([1, 2, 3], mu => 0, alternative => 'two.sided');
	my $b = t_test([1, 2, 3], mu => 0, alternative => 'two-sided');
	my $c = t_test([1, 2, 3], mu => 0, alternative => 'two_sided');
	is($a->{'p.value'}, $b->{'p.value'}, "SciPy's 'two-sided' spelling agrees");
	is($a->{'p.value'}, $c->{'p.value'}, "the 'two_sided' spelling agrees");
}

diag(sprintf 'worst relative error vs R: %s',
	join ', ', map { sprintf '%s %.3g', $_, $worst{$_} } sort keys %worst);

done_testing();
