# Everything here is produced by a build, a test run or a coverage run, and can
# be made again from what is committed.  Ignoring a path does NOT untrack a file
# that is already in the index: blib/, cover_db/, the XS build products and the
# MakeMaker files were committed before this file existed, and stayed tracked
# until 0.3414 removed them with `git ls-files -ci --exclude-standard' piped to
# `git rm --cached'.  Run the same pair again if anything listed here is ever
# tracked by mistake.

# ExtUtils::MakeMaker.  `Makefile' is generated by Makefile.PL, MYMETA.* by
# WriteMakefile() on every configure, and blib/ is the staging tree `make' fills
# and the test suite is run against (-Iblib/lib -Iblib/arch).
/Makefile
/Makefile.old
/MYMETA.json
/MYMETA.yml
/pm_to_blib
/blib/

# XS.  LikeR.c is xsubpp's output from LikeR.xs; LikeR.bs is the (empty)
# bootstrap file perl writes next to the shared object.
/LikeR.c
/LikeR.bs
*.o
*.obj
*.so
*.dll
*.dylib
*.def
*.exp

# Dist::Zilla.  `dzil build' writes the tarball and its unpacked tree into the
# repo root, and .build/ is dzil's scratch space -- which test.all.perls.pl also
# uses, for .build/multiperl/<perl>.<timestamp>.{log,result} and its work trees.
/.build/
/Stats-LikeR-*/
/Stats-LikeR-*.tar.gz

# Coverage and profiling.  cover_db/ is Devel::Cover's database; the .gcda/.gcno
# pair is gcc's, written beside the object file whenever the module is built
# with -fprofile-arcs, and dzil.sh checks that neither reaches a tarball.
/cover_db/
*.gcda
*.gcno
# gcov's annotated sources, written into whatever directory gcov runs in: up to
# 0.3416 a set from 2026-09-01 was tracked in the root, where cover_db/ went on
# reading their stale XS line counts.
*.gcov
nytprof.out
nytprof/

# R leaves these in whatever directory Rscript was started from; several of the
# reference scripts in the repo root are run that way.
.RData
.Rhistory

# Per-machine Claude Code settings.  .claude/settings.json and the hook script
# beside it are shared configuration and are deliberately not listed here.
.claude/settings.local.json

# Vim swap files, left beside whatever file is open in an editor.
.*.swp

# Backups left by patch(1) and by hand-applied edits. dzil.sh already keeps
# *.orig out of what it adds, but one already tracked shipped anyway:
# lib/Stats/LikeR.pm.orig was in the 0.3415 and 0.3416 tarballs, because
# [PruneFiles] keeps everything under lib/.
*.orig

# Python's bytecode cache, beside the reference scripts that write tables.
__pycache__/
*.pyc

# The POD that md2pod.pl used to write beside README.md; it now writes the POD
# into lib/Stats/LikeR.pm, and a copy left here only goes stale.
/read.me.pod

# Spreadsheets in the root: benchmark inputs for the author scripts
# (xlsx.pl reads "Affinity Dataset(main).xlsx"), and what lang.compare.pl writes.
# No test reads them, they are megabytes each, and t/ builds its .xlsx fixtures
# at run time.
/*.xlsx
